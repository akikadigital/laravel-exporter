{
    "name": "akika/laravel-exporter",
    "description": "A Laravel-native asynchronous export workflow for large datasets.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "export",
        "csv",
        "queue",
        "async",
        "large-data"
    ],
    "authors": [
        {
            "name": "Akika Digital"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Akika\\LaravelExporter\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Akika\\LaravelExporter\\ExporterServiceProvider"
            ],
            "aliases": {
                "Exporter": "Akika\\LaravelExporter\\Facades\\Exporter"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}