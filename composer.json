{
    "name": "akika/laravel-exporter",
    "description": "Asynchronous, queue-based data exports for Laravel applications.",
    "keywords": [
        "laravel",
        "export",
        "csv",
        "queue",
        "async",
        "large-data",
        "data-export"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Akika Digital"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/bus": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Akika\\LaravelExporter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Akika\\LaravelExporter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Akika\\LaravelExporter\\ExporterServiceProvider"
            ],
            "aliases": {
                "Exporter": "Akika\\LaravelExporter\\Facades\\Exporter"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}